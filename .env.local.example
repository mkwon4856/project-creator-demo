# ============================================
# Supabase
# ============================================
# Copy this file to .env.local and fill in your real Supabase project values.
# Get these from: https://app.supabase.com/project/<your-project>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only key (NEVER expose in client). Used for webhooks / admin tasks.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL for email deep links.
NEXT_PUBLIC_SITE_URL=https://project-creator-demo.vercel.app

# ============================================
# Email (Resend)
# ============================================
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=onboarding@resend.dev
# When set, all outbound mail is redirected here (development).
EMAIL_DEV_REDIRECT=you@example.com

# ============================================
# Webhooks
# ============================================
WEBHOOK_SECRET=your-random-webhook-secret

# ============================================
# Demo / development flags
# ============================================
# Show the sticky demo banner (landing + workspace layouts).
NEXT_PUBLIC_SHOW_DEMO_BANNER=true

# Allow the "DB 시드" button and seedCampaigns() in non-production builds only.
# Ignored when NODE_ENV=production.
NEXT_PUBLIC_ENABLE_SEED=true
