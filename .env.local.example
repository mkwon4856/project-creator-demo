# ============================================
# Supabase
# ============================================
# Copy this file to .env.local and fill in your real Supabase project values.
# Get these from: https://app.supabase.com/project/<your-project>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only key (NEVER expose in client). Used for migrations / admin tasks.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
